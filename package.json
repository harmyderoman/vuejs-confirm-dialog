{
	"name": "vuejs-confirm-dialog",
	"version": "0.6.0",
	"packageManager": "pnpm@12.6.0",
	"main": "./dist/vuejs-confirm-dialog.umd.js",
	"module": "./dist/vuejs-confirm-dialog.es.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/vuejs-confirm-dialog.es.js",
			"require": "./dist/vuejs-confirm-dialog.umd.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist/*"
	],
	"private": false,
	"author": {
		"name": "Roman Garmider"
	},
	"keywords": [
		"vue.js",
		"vue",
		"dialogs",
		"vue-use"
	],
	"license": "MIT",
	"scripts": {
		"demo": "vite --host",
		"lint": "eslint --fix src",
		"build": "vite build && vue-tsc --emitDeclarationOnly",
		"test": "vitest"
	},
	"dependencies": {
		"@vueuse/core": "^11.3.0",
		"vue-demi": "^0.14.10"
	},
	"peerDependencies": {
		"@vue/composition-api": "^1.0.0",
		"vue": "^2.0.0 || >=3.0.0"
